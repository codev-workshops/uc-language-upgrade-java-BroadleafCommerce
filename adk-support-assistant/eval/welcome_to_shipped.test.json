{
  "eval_set_id": "welcome_to_shipped",
  "name": "Welcome -> invalid -> reprompt -> valid -> lookup -> SHIPPED",
  "description": "Happy path for a shipped order. The invalid id returns to WelcomePage, then a valid id runs the entry webhook on OrderLookupPage and routes to the (undefined, terminal) FollowUpFlow.",
  "locale": "en",
  "order_data": {"123456": "SHIPPED"},
  "turns": [
    {"user": null, "expect_page": "WelcomePage", "expect_message_ids": ["WelcomePage.entry.0", "WelcomePage.order_id.initial.0"], "expect_handoff": false},
    {"user": "99999", "expect_page": "WelcomePage", "expect_message_ids": ["route-conditional-invalid.0"], "expect_handoff": false},
    {"user": "123456", "expect_page": "FollowUpFlow", "expect_message_ids": ["route-status-shipped.0"], "expect_handoff": false, "expect_session_params": {"order_status": "SHIPPED", "is_valid_order": true}}
  ]
}
