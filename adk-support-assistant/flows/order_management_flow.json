{
  "name": "00000000-0000-0000-0000-000000000000",
  "displayName": "OrderManagementFlow",
  "description": "Complex retail flow with dynamic conditions, slot filling, and system fallbacks.",
  "startPage": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/WelcomePage",
  "transitionRoutes": [
    {
      "name": "route-global-intent-cancel",
      "intent": "projects/sample-project/locations/global/agents/sample-agent/intents/Intent_Cancel_Order",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "Canceling the process. Let's return to the main menu."
              ]
            }
          }
        ]
      },
      "targetPage": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/MainMenu"
    }
  ],
  "eventHandlers": [
    {
      "name": "handler-sys-no-match-1",
      "event": "sys.no-match-1",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "I didn't quite catch that. Could you rephrase your request?"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "handler-sys-no-match-2",
      "event": "sys.no-match-2",
      "triggerFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "I am still having trouble understanding you. Let me route you to a live support team member."
              ]
            }
          }
        ],
        "liveAgentHandoff": {
          "metadata": {
            "reason": "Max consecutive no-match reached"
          }
        }
      }
    }
  ],
  "pages": [
    {
      "name": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/WelcomePage",
      "displayName": "WelcomePage",
      "entryFulfillment": {
        "messages": [
          {
            "text": {
              "text": [
                "Welcome to our automated assistant! Please provide your 6-digit order ID to begin."
              ]
            }
          }
        ]
      },
      "form": {
        "parameters": [
          {
            "displayName": "order_id",
            "required": true,
            "entityType": "projects/sample-project/locations/global/agents/sample-agent/entityTypes/sys.number",
            "fillBehavior": {
              "initialPromptFulfillment": {
                "messages": [
                  {
                    "text": {
                      "text": [
                        "What is your order number?"
                      ]
                    }
                  }
                ]
              },
              "repromptFulfillments": [
                {
                  "messages": [
                    "Please provide a valid 6-digit number."
                  ]
                }
              ]
            }
          }
        ]
      },
      "transitionRoutes": [
        {
          "name": "route-conditional-validation",
          "condition": "$session.params.order_id >= 100000 AND $session.params.order_id <= 999999",
          "triggerFulfillment": {
            "setParameterActions": [
              {
                "parameter": "is_valid_order",
                "value": true
              }
            ]
          },
          "targetPage": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/OrderLookupPage"
        },
        {
          "name": "route-conditional-invalid",
          "condition": "$session.params.order_id < 100000 OR $session.params.order_id > 999999",
          "triggerFulfillment": {
            "messages": [
              {
                "text": {
                  "text": [
                    "That order ID format is invalid. Let's try starting over."
                  ]
                }
              }
            ],
            "setParameterActions": [
              {
                "parameter": "order_id",
                "value": null
              }
            ]
          },
          "targetPage": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/WelcomePage"
        }
      ]
    },
    {
      "name": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/OrderLookupPage",
      "displayName": "OrderLookupPage",
      "entryFulfillment": {
        "webhook": "projects/sample-project/locations/global/agents/sample-agent/webhooks/ERP_Lookup_Service",
        "tag": "fetchOrderStatus"
      },
      "transitionRoutes": [
        {
          "name": "route-status-shipped",
          "condition": "$session.params.order_status = \"SHIPPED\"",
          "triggerFulfillment": {
            "messages": [
              {
                "text": {
                  "text": [
                    "Good news! Your order $session.params.order_id has shipped and will arrive via $session.params.carrier."
                  ]
                }
              }
            ]
          },
          "targetFlow": "projects/sample-project/locations/global/agents/sample-agent/flows/FollowUpFlow"
        },
        {
          "name": "route-status-pending",
          "condition": "$session.params.order_status = \"PENDING\"",
          "triggerFulfillment": {
            "messages": [
              {
                "text": {
                  "text": [
                    "Your order $session.params.order_id is currently being packed. Would you like to modify it?"
                  ]
                }
              }
            ]
          },
          "targetPage": "projects/sample-project/locations/global/agents/sample-agent/flows/0000/pages/ModifyOrderPage"
        }
      ]
    }
  ]
}

