# ---------------------------------------------------------------------------
# In-house LLM (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# LiteLlm routes "openai/<model>" to any OpenAI-compatible server.
INHOUSE_LLM_MODEL=openai/inhouse-gpt
INHOUSE_LLM_API_BASE=https://llm.internal.example.com/v1
INHOUSE_LLM_API_KEY=replace-me
# Optional generation controls
INHOUSE_LLM_TEMPERATURE=0.0
INHOUSE_LLM_MAX_TOKENS=512
INHOUSE_LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Order lookup backend (Broadleaf order-lookup endpoint)
# ---------------------------------------------------------------------------
# Set ORDER_LOOKUP_CLIENT=mock for local/dev/tests, or =http to call Broadleaf.
ORDER_LOOKUP_CLIENT=mock
ORDER_LOOKUP_BASE_URL=http://localhost:8080
ORDER_LOOKUP_PATH=/api/support/orders/{order_id}/status
ORDER_LOOKUP_API_KEY=
ORDER_LOOKUP_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Voice pipeline
# ---------------------------------------------------------------------------
# Adapter selection: "noop" (echo/silence, used in tests) or a custom entry.
STT_ENGINE=noop
TTS_ENGINE=noop

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es
LOG_LEVEL=INFO
REDACT_PII=true
